<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaCare 管家 — 专业级 3D Liquid Glass 图标
  设计风格：One UI 8.5 "3D Liquid Glass" + 抽象守护概念
  - 渐变靛蓝背景（暗示保护、信任）
  - 居中 squircle 玻璃质感容器
  - 内部抽象 "盾 + 守护环" 几何
  - 高光与阴影营造 3D 立体感
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 内层 squircle 玻璃容器（半透明白） -->
    <path
        android:pathData="M 30,30 L 78,30 C 84.6,30 90,35.4 90,42 L 90,66 C 90,72.6 84.6,78 78,78 L 30,78 C 23.4,78 18,72.6 18,66 L 18,42 C 18,35.4 23.4,30 30,30 Z"
        android:fillColor="#80FFFFFF" />

    <!-- 抽象守护盾牌（白色实心） -->
    <path
        android:pathData="M 54,36 L 70,42 L 70,55 C 70,63 62.5,70 54,72 C 45.5,70 38,63 38,55 L 38,42 Z"
        android:fillColor="#FFFFFF" />

    <!-- 盾牌内部心率曲线 -->
    <path
        android:strokeColor="#3B5BDB"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 44,55 L 49,55 L 52,49 L 55,61 L 58,52 L 61,55 L 64,55" />

    <!-- 高光（顶部弧形，Liquid Glass 反射） -->
    <path
        android:pathData="M 30,38 C 30,33.6 33.6,30 38,30 L 70,30 C 74.4,30 78,33.6 78,38 L 78,40 C 78,36 75,32 70,32 L 38,32 C 33,32 30,36 30,40 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

    <!-- 底部阴影（增强 3D 感） -->
    <path
        android:pathData="M 30,68 C 30,72.4 33.6,76 38,76 L 70,76 C 74.4,76 78,72.4 78,68 L 78,70 C 78,74.4 74.4,78 70,78 L 38,78 C 33.6,78 30,74.4 30,70 Z"
        android:fillColor="#1A0D1B6E" />

</vector>