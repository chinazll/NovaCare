<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 枚举已安装应用（清理残留 / 冻结）；Play 上架需在数据安全表单说明用途 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 应用使用时长（判定「不常用」），需用户在设置中授权 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 卸载应用 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      完整文件访问（Android 11+）。
      为什么必须要有：内核 Rust 侧用 walkdir 直接按路径扫描 /storage/emulated/0。
      没有这个权限时，分区存储会让内核在访问其他应用的目录时拿到 EACCES，
      扫描结果严重偏少 —— 用户看到的是"扫描不出东西"，会直接认为应用坏了。
      申请入口：SystemPermissions.allFilesAccessIntent() → 系统设置页手动开启。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 清理完成通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 长任务前台执行 / 定时任务重排 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      L3 云端 AI 专用。
      隐私红线：默认不发起任何网络请求 —— 只有用户在设置里主动开启「高级 AI」、
      并填入自己的 API Key 之后才会联网。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      流量模块（feature/traffic）专用：让 ConnectivityManager / TrafficStats
      能查询当前网络接口的活跃状态。读取其他 UID 的流量仍需系统授权，
      本权限只解决"能不能看到 NetworkInfo"这一步。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NovaCareApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.NovaCare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NovaCare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager 默认通过 androidx.startup 在 Application.onCreate 之前初始化。
          那样会用默认 WorkerFactory 建好实例，NovaCareApp 的 Configuration.Provider
          就永远不会被读取 —— @HiltWorker AutomationWorker 无法实例化，定时任务静默失败。
          这里移除默认初始化节点，把初始化权交回 Configuration.Provider。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
