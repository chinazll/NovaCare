<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 枚举已安装应用（清理残留 / 冻结）；Play 上架需在数据安全表单说明用途 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 应用使用时长（判定「不常用」），需用户在设置中授权 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" xmlns:tools="http://schemas.android.com/tools" />

    <!-- 卸载应用 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- 清理完成通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 长任务前台执行 / 定时任务重排 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      L3 云端 AI 专用。
      隐私红线：默认不发起任何网络请求 —— 只有用户在设置里主动开启「高级 AI」、
      并填入自己的 API Key 之后才会联网。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NovaCareApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaCare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NovaCare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
